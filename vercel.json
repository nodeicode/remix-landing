{
	"crons": [
		{
			"path": "/api/trigger-push",
			"schedule": "5 14 * * *"
		}
	],
	"headers": [
		{
			"source": "/api/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-store, no-cache, must-revalidate, max-age=0"
				},
				{
					"key": "CDN-Cache-Control",
					"value": "no-store"
				},
				{
					"key": "Vercel-CDN-Cache-Control",
					"value": "no-store"
				}
			]
		}
	]
}